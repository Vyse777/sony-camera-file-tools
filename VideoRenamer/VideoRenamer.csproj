<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\macos\ffprobe">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </EmbeddedResource>
        <None Remove="Resources\linux\ffprobe"/>
        <EmbeddedResource Include="Resources\linux\ffprobe">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FFMpegCore" Version="5.5.0" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
    </ItemGroup>
</Project>
